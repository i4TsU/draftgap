{
    "name": "draftgap",
    "version": "3.2.1",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "bump-version": "bun run typecheck && bun scripts/bump-version.ts",
        "typecheck": "turbo typecheck",
        "dev": "bun run --filter @draftgap/frontend dev",
        "tauri": "bun run --filter @draftgap/frontend tauri",
        "setup:all": "bun scripts/cross-repo.ts setup",
        "check:all": "bun scripts/cross-repo.ts check",
        "dev:all": "bun scripts/cross-repo.ts dev",
        "test:integration": "bun test scripts/integration/lolmix-http.test.ts",
        "test:orchestration": "bun test scripts/integration/owned-process.test.ts"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "dependencies": {
        "turbo": "^2.9.18"
    },
    "packageManager": "bun@1.3.6"
}
